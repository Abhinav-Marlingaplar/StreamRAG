DATABASE_URL=postgresql+psycopg2://streamrag:streamrag@localhost:5432/streamrag

# Auth / JWT
JWT_SECRET=replace-with-strong-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM (Groq)
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=streamrag-ingestion

# Embeddings / logging
EMBEDDING_MODEL=all-MiniLM-L6-v2
LOG_LEVEL=INFO

# TAR retrieval (Temporal-Aware Adaptive Retrieval)
TAR_LAMBDA_PER_MINUTE=0.02
TAR_GAMMA=0.5
TAR_PRELIM_K=5
TAR_HIGH_THRESHOLD=0.65
TAR_LOW_THRESHOLD=0.35
TAR_TIER_HIGH_K=1
TAR_TIER_MID_K=3
TAR_TIER_LOW_K=5
TAR_TIER_HIGH_ALPHA=0.455
TAR_TIER_MID_ALPHA=0.65
TAR_TIER_LOW_ALPHA=0.91